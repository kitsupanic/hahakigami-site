{
  // Separate Worker so the main site stays static-only. Deploy by hand from the repo root: pnpm exec wrangler deploy --config redirect/wrangler.jsonc
  "name": "hahakigami-app-redirect",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "hahakigami.app", "custom_domain": true },
    { "pattern": "www.hahakigami.app", "custom_domain": true },
    { "pattern": "www.hahakigami.com", "custom_domain": true }
  ]
}
